{
  "app": "Plant Swap",
  "idea": "Neighbours list houseplant cuttings they can spare and swap them with each other. Someone offers one of their own plants for a cutting they like; the owner accepts or declines, and they mark the swap done once the plants have changed hands.",
  "stack": "ts",
  "store": "jsonl",
  "events": [
    {
      "name": "PlantListed",
      "fields": [
        "plantId",
        "ownerId",
        "species",
        "note"
      ]
    },
    {
      "name": "SwapRequested",
      "fields": [
        "swapId",
        "plantId",
        "requesterId",
        "offeredPlantId"
      ]
    },
    {
      "name": "SwapAccepted",
      "fields": [
        "swapId",
        "acceptedAt"
      ]
    },
    {
      "name": "SwapDeclined",
      "fields": [
        "swapId",
        "reason"
      ]
    },
    {
      "name": "PlantsHandedOver",
      "fields": [
        "swapId",
        "handedOverAt"
      ]
    }
  ],
  "slices": [
    {
      "name": "ListPlant",
      "kind": "command",
      "fields": [
        "ownerId",
        "species",
        "note"
      ],
      "produces": [
        "PlantListed"
      ],
      "scenarios": [
        {
          "given": [],
          "when": "ListPlant",
          "then": {
            "event": "PlantListed"
          }
        },
        {
          "given": [],
          "when": "ListPlant",
          "then": {
            "refused": "Species is required"
          }
        }
      ]
    },
    {
      "name": "RequestSwap",
      "kind": "command",
      "fields": [
        "plantId",
        "requesterId",
        "offeredPlantId"
      ],
      "produces": [
        "SwapRequested"
      ],
      "scenarios": [
        {
          "given": [
            "PlantListed"
          ],
          "when": "RequestSwap",
          "then": {
            "event": "SwapRequested"
          }
        },
        {
          "given": [],
          "when": "RequestSwap",
          "then": {
            "refused": "That plant isn't listed"
          }
        },
        {
          "given": [
            "PlantListed",
            "SwapRequested",
            "SwapAccepted",
            "PlantsHandedOver"
          ],
          "when": "RequestSwap",
          "then": {
            "refused": "That plant has already been swapped"
          }
        }
      ]
    },
    {
      "name": "AcceptSwap",
      "kind": "command",
      "fields": [
        "swapId",
        "ownerId"
      ],
      "produces": [
        "SwapAccepted"
      ],
      "scenarios": [
        {
          "given": [
            "PlantListed",
            "SwapRequested"
          ],
          "when": "AcceptSwap",
          "then": {
            "event": "SwapAccepted"
          }
        },
        {
          "given": [
            "PlantListed",
            "SwapRequested",
            "SwapDeclined"
          ],
          "when": "AcceptSwap",
          "then": {
            "refused": "That swap was already declined"
          }
        }
      ]
    },
    {
      "name": "DeclineSwap",
      "kind": "command",
      "fields": [
        "swapId",
        "ownerId",
        "reason"
      ],
      "produces": [
        "SwapDeclined"
      ],
      "scenarios": [
        {
          "given": [
            "PlantListed",
            "SwapRequested"
          ],
          "when": "DeclineSwap",
          "then": {
            "event": "SwapDeclined"
          }
        }
      ]
    },
    {
      "name": "ConfirmHandover",
      "kind": "command",
      "fields": [
        "swapId"
      ],
      "produces": [
        "PlantsHandedOver"
      ],
      "scenarios": [
        {
          "given": [
            "PlantListed",
            "SwapRequested",
            "SwapAccepted"
          ],
          "when": "ConfirmHandover",
          "then": {
            "event": "PlantsHandedOver"
          }
        },
        {
          "given": [
            "PlantListed",
            "SwapRequested"
          ],
          "when": "ConfirmHandover",
          "then": {
            "refused": "The swap hasn't been accepted yet"
          }
        }
      ]
    },
    {
      "name": "AvailablePlants",
      "kind": "view",
      "fields": [
        "plantId",
        "species",
        "ownerId"
      ],
      "reads": [
        "PlantListed",
        "PlantsHandedOver"
      ],
      "scenarios": [
        {
          "given": [
            "PlantListed"
          ],
          "when": "open AvailablePlants",
          "then": {
            "shows": "the plant, with its species"
          }
        },
        {
          "given": [
            "PlantListed",
            "SwapRequested",
            "SwapAccepted",
            "PlantsHandedOver"
          ],
          "when": "open AvailablePlants",
          "then": {
            "shows": "nothing: the plant has been swapped"
          }
        }
      ]
    },
    {
      "name": "MySwapRequests",
      "kind": "view",
      "fields": [
        "swapId",
        "species",
        "status"
      ],
      "reads": [
        "SwapRequested",
        "SwapAccepted",
        "SwapDeclined"
      ],
      "scenarios": [
        {
          "given": [
            "PlantListed",
            "SwapRequested",
            "SwapAccepted"
          ],
          "when": "open MySwapRequests",
          "then": {
            "shows": "the swap, status Accepted"
          }
        }
      ]
    }
  ]
}
